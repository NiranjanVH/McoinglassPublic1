# Copy this file to .env and fill in the values locally.
TG_API_ID=
TG_API_HASH=
TG_TARGET_CHAT=
TG_SESSION_NAME=telegram_session
TG_SESSION_STRING=
STATE_FILE=last_processed_signal_id.txt

COINDCX_API_KEY=
COINDCX_API_SECRET=

OCI_VM_HOST=
OCI_VM_PORT=22
OCI_VM_USER=
OCI_SSH_PRIVATE_KEY_B64=
SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts
SOCKS_HOST=127.0.0.1
SOCKS_PORT=1080

# Keep enabled while testing. Set to false only when explicitly ready for live orders.
DRY_RUN=true
